{
  "name": "wbseva-ai",
  "version": 2,
  "public": true,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/scheme-details.html",
      "dest": "/scheme-details.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}